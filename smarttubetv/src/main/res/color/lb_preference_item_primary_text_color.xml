<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: iOS 6 plain table text, white on the blue selection -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ios6_cell_disabled_text" />
    <item android:state_focused="true" android:color="@color/ios6_white" />
    <item android:state_pressed="true" android:color="@color/ios6_white" />
    <item android:color="@color/ios6_cell_text"/>
</selector>
