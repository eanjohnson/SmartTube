<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: SwitchPreference widget drawn as an iOS 6 UISwitch. Library: androidx.preference:preference:1.1.0 -->
<Switch
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="NewApi"
    android:id="@android:id/switch_widget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:clickable="false"
    android:thumb="@drawable/ios6_switch_thumb"
    android:track="@drawable/ios6_switch_track"
    android:switchMinWidth="64dp"
    android:textOn=""
    android:textOff=""
    android:background="@null"/>
