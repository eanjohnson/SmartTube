<?xml version="1.0" encoding="utf-8"?>
<!--
    TeX Gyre Heros, a free Helvetica-style typeface used by the iOS 6 theme.
    License and provenance: tools/ios6/fonts/README.md
    It covers Latin and Greek only. Cyrillic, CJK and other scripts fall back to the system font.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/ios6_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/ios6_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/ios6_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/ios6_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
