<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 6 style focus: a soft blue glow behind the icon (pre-Lollipop approximation) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#8C1E6EEB" />
            <stroke android:width="1dp" android:color="#663FA9FF" />
            <size
                android:height="@dimen/lb_control_button_diameter"
                android:width="@dimen/lb_control_button_diameter" />
        </shape>
    </item>
</selector>
