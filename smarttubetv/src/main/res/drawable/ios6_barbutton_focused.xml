<?xml version="1.0" encoding="utf-8"?>
<!-- Focused bar button: the bright blue "Done" style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A2A6B" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#5B9AF7"
                android:centerColor="#2B71EC"
                android:endColor="#1452D4"
                android:type="linear" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.45"
                android:type="linear" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
