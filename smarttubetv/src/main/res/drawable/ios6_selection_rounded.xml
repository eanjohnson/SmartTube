<?xml version="1.0" encoding="utf-8"?>
<!-- Blue selection used on the linen side panel: a rounded, glossy pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#07357E" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/ios6_selection_start"
                android:endColor="@color/ios6_selection_end"
                android:type="linear" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.5"
                android:type="linear" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
