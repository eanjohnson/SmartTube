<?xml version="1.0" encoding="utf-8"?>
<!-- UITableViewCell (plain style): white row with an inset separator, blue gradient when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/ios6_selection" />
    <item android:state_pressed="true" android:drawable="@drawable/ios6_selection" />
    <item>
        <layer-list>
            <item android:left="@dimen/ios6_cell_separator_inset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios6_cell_separator" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ios6_table_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
